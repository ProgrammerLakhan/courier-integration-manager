# Application
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=courier_user
DB_PASSWORD=courier_pass
DB_NAME=courier_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=super-secret-change-in-production
JWT_REFRESH_SECRET=super-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Default Admin Seed
ADMIN_EMAIL=admin@courier.com
ADMIN_PASSWORD=Admin@123456

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# BullMQ
BULLMQ_CONCURRENCY=10

# UrbaneBolt (UAT credentials)
URBANEBOLT_BASE_URL=<URBANEBOLT_BASE_URL>
URBANEBOLT_USERNAME=<URBANEBOLT_USERNAME>
URBANEBOLT_PASSWORD=<URBANEBOLT_PASSWORD>
URBANEBOLT_CUSTOMER_CODE=<URBANEBOLT_CUSTOMER_CODE>
